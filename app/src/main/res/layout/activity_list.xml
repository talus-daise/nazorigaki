<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/paper" android:padding="16dp">
    <Button android:id="@+id/backButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="← もどる" />
    <TextView android:id="@+id/titleText" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="28sp" android:textStyle="bold" android:textColor="@color/navy" android:layout_marginTop="8dp" />
    <TextView android:id="@+id/subtitleText" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="14sp" android:layout_marginBottom="12dp" />
    <GridView android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="match_parent"
        android:numColumns="5" android:horizontalSpacing="8dp" android:verticalSpacing="8dp" />
</LinearLayout>
